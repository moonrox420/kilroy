{
  "name": "kilroy",
  "private": true,
  "version": "0.1.0",
  "description": "Kilroy — Local AI Agentic Software Engineering Platform for Windows 11",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:hard-reset": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-reset.ps1 -Rust && npm run tauri:dev",
    "dev:fresh": "npm run cache:clear && vite",
    "build": "tsc -b && vite build",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "check": "npm run build && npm run typecheck:test && npm test",
    "check:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-all.ps1",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "powershell -NoProfile -Command \"$cargoHome = Join-Path $env:USERPROFILE '.cargo'; $rustupHome = Join-Path $env:USERPROFILE '.rustup'; $cargoBin = Join-Path $cargoHome 'bin'; $env:CARGO_HOME = $cargoHome; $env:RUSTUP_HOME = $rustupHome; $env:Path = $cargoBin + ';' + $env:Path; tauri dev\"",
    "tauri:dev:fresh": "npm run cache:clear && npm run tauri:dev",
    "tauri:build": "powershell -NoProfile -Command \"$cargoHome = Join-Path $env:USERPROFILE '.cargo'; $rustupHome = Join-Path $env:USERPROFILE '.rustup'; $cargoBin = Join-Path $cargoHome 'bin'; $env:CARGO_HOME = $cargoHome; $env:RUSTUP_HOME = $rustupHome; $env:Path = $cargoBin + ';' + $env:Path; tauri build\"",
    "cache:clear": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-reset.ps1",
    "icons:regen": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/regen-icons.ps1",
    "fetch:ollama": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-ollama.ps1",
    "doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/doctor.ps1",
    "build:release": "npm run doctor && npm run fetch:ollama && npm run cache:clear && npm run tauri:build",
    "bump": "npm update && npm install && cd src-tauri && cargo update",
    "bump:check": "npm outdated --silent || true && cd src-tauri && cargo outdated --root-deps-only --depth 1 || true",
    "wipe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall.ps1",
    "wipe:dry": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall.ps1 -DryRun",
    "wipe:nuke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall.ps1 -IncludeBuild -IncludeProjectData",
    "wipe:force": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/force-uninstall.ps1",
    "wipe:force-nuke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/force-uninstall.ps1 -IncludeBuild -IncludeProjectData",
    "ps:list": "powershell -NoProfile -Command \"Get-CimInstance Win32_Process | Where-Object { $_.ExecutablePath -match 'Kilroy|com.kilroy.desktop' -or $_.CommandLine -match 'Kilroy|com.kilroy.desktop' } | Format-Table ProcessId,Name,ExecutablePath -AutoSize\"",
    "ps:kill": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-reset.ps1 -StopOnly"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-context-menu": "^2.3.2",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-scroll-area": "^1.2.13",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.16",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "monaco-editor": "^0.53.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
