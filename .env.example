# Kilroy environment variable overrides
# Copy to .env and uncomment to override defaults.

# Ollama host (default: http://127.0.0.1:11434)
# KILROY_OLLAMA_HOST=http://127.0.0.1:11434

# Chat model tag (default: qwen2.5-coder:14b-instruct-q8_0)
# KILROY_CHAT_MODEL=qwen2.5-coder:14b-instruct-q8_0

# Embedding model tag (default: nomic-embed-text)
# KILROY_EMBEDDING_MODEL=nomic-embed-text

# Sandbox isolation mode: host | windows_sandbox | docker (default: host)
# KILROY_SANDBOX=host

# Log level: DEBUG | INFO | WARN | ERROR (default: INFO)
# KILROY_LOG_LEVEL=INFO